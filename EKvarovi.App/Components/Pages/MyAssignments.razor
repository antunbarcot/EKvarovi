@page "/my-assignments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>Moji nalozi</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Moji nalozi</MudText>

@if (_isLoading)
{
    <div class="d-flex justify-center align-center" style="min-height: 60vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (!_hasAccess)
{
    <MudAlert Severity="Severity.Warning">Nemate pristup ovoj stranici.</MudAlert>
}
else if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else if (_assignments.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Engineering" Message="Nemate trenutno aktivnih naloga." />
}
else
{
    <MudGrid>
        @foreach (var view in _assignments)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">@view.Assignment.FaultReportDescription</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@view.Assignment.LocationName</MudText>

                        <MudText Typo="Typo.caption" Class="mt-3 d-block">Dodijeljeno</MudText>
                        <MudText Typo="Typo.body2">@view.Assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")</MudText>

                        <MudText Typo="Typo.caption" Class="mt-3 d-block">Intervencija</MudText>
                        <MudChip T="string" Color="@InterventionColor(view.CurrentInterventionStatus)" Size="Size.Small">
                            @(view.CurrentInterventionStatus ?? "Nema pokrenute")
                        </MudChip>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="@(() => NavigationManager.NavigateTo($"/fault-reports/{view.Assignment.FaultReportId}"))">
                            Otvori nalog
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private sealed class AssignmentView
    {
        public WorkAssignmentDto Assignment { get; init; } = null!;
        public string? CurrentInterventionStatus { get; init; }
    }

    private List<AssignmentView> _assignments = new();
    private bool _isLoading = true;
    private bool _hasAccess;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUserService.EnsureInitializedAsync();
        _hasAccess = CurrentUserService.IsInRole("Technician");

        if (_hasAccess)
        {
            await LoadDataAsync();
        }
        else
        {
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var assignments = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>("api/work-assignments/mine") ?? new();

            var views = new List<AssignmentView>();
            foreach (var assignment in assignments)
            {
                var interventions = await Http.GetFromJsonAsync<List<InterventionDto>>(
                    $"api/interventions?workAssignmentId={assignment.Id}") ?? new();

                var current = interventions.FirstOrDefault(i => i.InterventionStatusName == "U tijeku")
                    ?? interventions.OrderByDescending(i => i.StartedAt).FirstOrDefault();

                views.Add(new AssignmentView
                {
                    Assignment = assignment,
                    CurrentInterventionStatus = current?.InterventionStatusName
                });
            }

            _assignments = views;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja naloga: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static Color InterventionColor(string? statusName) => statusName switch
    {
        "U tijeku" => Color.Warning,
        "Završena" => Color.Success,
        "Neuspješna" => Color.Error,
        _ => Color.Default
    };
}
