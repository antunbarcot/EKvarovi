    private async Task CloseFaultReportAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Zatvaranje prijave",
            "Jeste li sigurni da želite zatvoriti ovu prijavu? Ova akcija označava kraj obrade kvara.",
            yesText: "Zatvori", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        _isClosing = true;
        _closeErrorMessage = null;

        try
        {
            var response = await Http.PutAsync($"api/fault-reports/{Id}/close", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Prijava je zatvorena.", Severity.Success);
                await LoadFaultReportAsync();
                await LoadHistoryAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _closeErrorMessage = await ReadErrorMessageAsync(response);
            }
            else
            {
                _closeErrorMessage = $"Greška prilikom zatvaranja prijave (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _closeErrorMessage = $"Greška prilikom zatvaranja prijave: {ex.Message}";
        }
        finally
        {
            _isClosing = false;
        }
    }

