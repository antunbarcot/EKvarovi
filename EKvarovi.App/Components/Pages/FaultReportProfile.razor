@page "/fault-reports/{Id:int}"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using EKvarovi.App.Components.Dialogs
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject CurrentUserService CurrentUserService

<PageTitle>Prijava #@Id</PageTitle>

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/fault-reports"))" Class="mb-4">
    Natrag na popis
</MudButton>

@if (_isLoadingReport)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_reportErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@_reportErrorMessage</MudAlert>
}
else if (_faultReport is null)
{
    <MudAlert Severity="Severity.Warning">Prijava nije pronađena.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <MudText Typo="Typo.h5" Class="mb-3">Prijava #@_faultReport.Id</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body1"><strong>Opis:</strong> @_faultReport.Description</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2"><strong>Lokacija:</strong> @_faultReport.LocationName</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2"><strong>Prijavitelj:</strong> @_faultReport.ReporterName</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2"><strong>Tip kvara:</strong> @_faultReport.FaultTypeName</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2">
                    <strong>Prioritet:</strong>
                    <MudChip T="string" Color="@PriorityColor(_faultReport.FaultPriorityName)" Size="Size.Small">@_faultReport.FaultPriorityName</MudChip>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2">
                    <strong>Status:</strong>
                    <MudChip T="string" Color="@StatusColor(_faultReport.FaultStatusName)" Size="Size.Small">@_faultReport.FaultStatusName</MudChip>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2"><strong>Rok:</strong> @(_faultReport.DueDate?.ToString("dd.MM.yyyy") ?? "-")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2"><strong>Kreirano:</strong> @_faultReport.CreatedAt.ToString("dd.MM.yyyy HH:mm")</MudText>
            </MudItem>
        </MudGrid>

        @if (_faultReport.FaultStatusName == StatusRijeseno && (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager")))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.TaskAlt"
                       OnClick="CloseFaultReportAsync" Disabled="_isClosing" Class="mt-4">
                Zatvori prijavu
            </MudButton>
        }

        @if (_closeErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_closeErrorMessage</MudAlert>
        }
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mb-3">Vremenska crta</MudText>

    @if (_isLoadingHistory)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_historyErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-6">@_historyErrorMessage</MudAlert>
    }
    else if (_history.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">Nema zabilježenih promjena.</MudAlert>
    }
    else
    {
        <MudTimeline TimelinePosition="TimelinePosition.Right" Class="mb-6">
            @foreach (var historyEvent in _history)
            {
                <MudTimelineItem Color="@HistoryEventColor(historyEvent.EventType)" Icon="@HistoryEventIcon(historyEvent.EventType)">
                    <ItemContent>
                        <MudText Typo="Typo.body1">@HistoryEventDescription(historyEvent)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @historyEvent.ChangedByName · @historyEvent.ChangedAt.ToString("dd.MM.yyyy. HH:mm")
                        </MudText>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }

    <MudText Typo="Typo.h5" Class="mb-3">Dodjele</MudText>

    @if (!_isLoadingAssignments && (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager")))
    {
        if (!_hasActiveAssignment)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAssignDialogAsync" Class="mb-4">
                Dodijeli izvršitelja
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz"
                       OnClick="OpenReassignDialogAsync" Class="mb-4">
                Ponovno dodijeli
            </MudButton>
        }
    }

    @if (_isLoadingAssignments)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_assignmentsErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@_assignmentsErrorMessage</MudAlert>
    }
    else if (_assignments.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Prijava još nema nijednu dodjelu.</MudAlert>
    }
    else
    {
        @foreach (var assignment in _assignments.OrderByDescending(a => a.AssignedAt))
        {
            <MudPaper Class="pa-3 mb-3" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">@assignment.TechnicianName</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        @if (assignment.IsActive)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktivna</MudChip>
                        }
                        @if (HasInterventions(assignment.Id) && (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager")))
                        {
                            <MudTooltip Text="AI sažetak radnog naloga">
                                <MudIconButton Icon="@Icons.Material.Filled.Summarize" Size="Size.Small" Color="Color.Secondary"
                                               OnClick="@(() => ShowAiSummaryAsync(assignment.Id))" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudStack>
                <MudText Typo="Typo.body2">Dodijeljeno: @assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")</MudText>
                <MudText Typo="Typo.body2">
                    @(assignment.UnassignedAt.HasValue
                        ? $"Deaktivirano: {assignment.UnassignedAt.Value:dd.MM.yyyy HH:mm}"
                        : "Trenutno aktivna")
                </MudText>
                @if (!string.IsNullOrWhiteSpace(assignment.ReassignmentNote))
                {
                    <MudText Typo="Typo.body2" Class="mt-1"><em>Napomena: @assignment.ReassignmentNote</em></MudText>
                }
            </MudPaper>
        }
    }

    <MudText Typo="Typo.h5" Class="mb-3">Intervencije</MudText>

    @if (!_isLoadingInterventions && _activeAssignment is not null && _ongoingIntervention is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="StartInterventionAsync" Disabled="_isStartingIntervention" Class="mb-4" Size="Size.Large">
            Pokreni intervenciju
        </MudButton>
    }

    @if (_isLoadingInterventions)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_interventionsErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@_interventionsErrorMessage</MudAlert>
    }
    else if (_interventions.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Prijava još nema nijednu intervenciju.</MudAlert>
    }
    else
    {
        @foreach (var intervention in _interventions.OrderByDescending(i => i.StartedAt))
        {
            <MudPaper Class="pa-3 mb-3" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">@intervention.TechnicianName</MudText>
                    <MudChip T="string" Color="@InterventionStatusColor(intervention.InterventionStatusName)" Size="Size.Small">
                        @intervention.InterventionStatusName
                    </MudChip>
                </MudStack>
                <MudText Typo="Typo.body2">Početak: @(intervention.StartedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudText>
                <MudText Typo="Typo.body2">Kraj: @(intervention.EndedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudText>
                <MudText Typo="Typo.body2">Trajanje: @(intervention.DurationMinutes.HasValue ? $"{intervention.DurationMinutes} min" : "-")</MudText>
                @if (!string.IsNullOrWhiteSpace(intervention.Notes))
                {
                    <MudText Typo="Typo.body2" Class="mt-1"><em>Bilješka: @intervention.Notes</em></MudText>
                }

                @if (intervention.Materials.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2"><strong>Utrošeni materijal:</strong></MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var material in intervention.Materials)
                        {
                            <MudListItem T="string">@material.MaterialName - @material.Quantity @material.MaterialUnitAbbreviation</MudListItem>
                        }
                    </MudList>
                }

                @if (intervention.InterventionStatusName == StatusUTijeku)
                {
                    <MudDivider Class="my-3" />

                    <MudStack Row="true" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
                        <MudSelect T="int?" @bind-Value="_newMaterialId" Label="Materijal" Style="min-width: 220px;">
                            @foreach (var material in _materials.Where(m => m.IsActive))
                            {
                                <MudSelectItem T="int?" Value="material.Id">@material.Name (@material.MaterialUnitAbbreviation)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal?" @bind-Value="_newMaterialQuantity" Label="Količina" Min="0.01m" Style="max-width: 140px;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => AddMaterialAsync(intervention.Id))" Disabled="_isAddingMaterial" Size="Size.Large">
                            Dodaj materijal
                        </MudButton>
                    </MudStack>

                    @if (_materialErrorMessage is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@_materialErrorMessage</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Done"
                               OnClick="@(() => OpenCompleteDialogAsync(intervention.Id))" Size="Size.Large">
                        Završi intervenciju
                    </MudButton>
                }
            </MudPaper>
        }
    }

    <MudText Typo="Typo.h5" Class="mb-3">Privitci</MudText>

    <MudPaper Class="pa-3 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?" @bind-Value="_selectedPurposeId" Label="Namjena">
                    @foreach (var purpose in _attachmentPurposes)
                    {
                        <MudSelectItem T="int?" Value="purpose.Id">@PurposeDisplayName(purpose.Name)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_interventions.Count > 0)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?" @bind-Value="_selectedInterventionId" Label="Vezano uz intervenciju (opcionalno)" Clearable="true">
                        @foreach (var intervention in _interventions.OrderByDescending(i => i.StartedAt))
                        {
                            <MudSelectItem T="int?" Value="intervention.Id">
                                @($"#{intervention.Id} - {intervention.InterventionStatusName}")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="8" md="4">
                <InputFile OnChange="OnFileSelected" accept="@AcceptAttribute" />
                @if (_selectedFile is not null)
                {
                    <MudText Typo="Typo.caption">@_selectedFile.Name (@FormatFileSize(_selectedFile.Size))</MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="4" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload"
                           OnClick="UploadAttachmentAsync" Disabled="_isUploading" Size="Size.Large" FullWidth="true">
                    Uploadaj
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_isUploading)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }

        @if (_uploadErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_uploadErrorMessage</MudAlert>
        }
    </MudPaper>

    @if (!_isLoadingAttachments && _attachmentsErrorMessage is null)
    {
        <MudText Typo="Typo.h6" Class="mb-2">Usporedba prije/poslije</MudText>

        @if (_beforePhotos.Count == 0 || _afterPhotoGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">Nedostaje fotografija za usporedbu.</MudAlert>
        }
        else
        {
            @foreach (var group in _afterPhotoGroups)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@InterventionComparisonLabel(group.Key)</MudText>
                    <MudDivider Class="mb-3" />
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.body2" Class="mb-2"><strong>Prije popravka</strong></MudText>
                            @foreach (var photo in _beforePhotos)
                            {
                                <MudImage Src="@FullUrl(photo.DownloadUrl)" Height="300" Class="rounded-lg mb-2" Style="width:100%; object-fit:cover;" />
                            }
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.body2" Class="mb-2"><strong>Nakon popravka</strong></MudText>
                            @foreach (var photo in group)
                            {
                                <MudImage Src="@FullUrl(photo.DownloadUrl)" Height="300" Class="rounded-lg mb-2" Style="width:100%; object-fit:cover;" />
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        }
    }

    @if (_isLoadingAttachments)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_attachmentsErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@_attachmentsErrorMessage</MudAlert>
    }
    else if (_attachments.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Prijava još nema nijedan privitak.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var attachment in _attachments)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard>
                        @if (IsPhotoPurpose(attachment.AttachmentPurposeName))
                        {
                            <MudCardMedia Image="@FullUrl(attachment.DownloadUrl)" Height="180" />
                        }
                        else
                        {
                            <MudCardContent Class="d-flex flex-column align-center">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large" Color="Color.Error" />
                                <MudLink Href="@FullUrl(attachment.DownloadUrl)" Target="_blank">Preuzmi</MudLink>
                            </MudCardContent>
                        }
                        <MudCardContent>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mb-1">@PurposeDisplayName(attachment.AttachmentPurposeName)</MudChip>
                            <MudText Typo="Typo.body2">@attachment.OriginalFileName</MudText>
                            <MudText Typo="Typo.caption">@FormatFileSize(attachment.FileSizeBytes)</MudText>
                            <MudText Typo="Typo.caption">@attachment.UploadedAt.ToString("dd.MM.yyyy HH:mm")</MudText>
                        </MudCardContent>
                        @if (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager"))
                        {
                            <MudCardActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="@(() => DeleteAttachmentAsync(attachment))" />
                            </MudCardActions>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private const string PriorityKritican = "Kritičan";
    private const string PriorityVisok = "Visok";
    private const string PrioritySrednji = "Srednji";
    private const string PriorityNizak = "Nizak";

    private const string StatusUTijeku = "U tijeku";
    private const string StatusRijeseno = "Riješeno";

    private const string PurposeFotografijaPrije = "FotografijaPrije";
    private const string PurposeFotografijaPoslije = "FotografijaPoslije";
    private const string PurposeDokument = "Dokument";
    private const long MaxAttachmentSizeBytes = 10 * 1024 * 1024;

    private FaultReportDto? _faultReport;
    private List<WorkAssignmentDto> _assignments = new();
    private List<LookupDto> _technicians = new();
    private List<InterventionDto> _interventions = new();
    private List<MaterialDto> _materials = new();
    private List<AttachmentDto> _attachments = new();
    private List<LookupDto> _attachmentPurposes = new();
    private List<FaultReportHistoryEventDto> _history = new();

    private bool _isLoadingReport = true;
    private bool _isLoadingAssignments = true;
    private bool _isLoadingInterventions = true;
    private bool _isLoadingAttachments = true;
    private bool _isLoadingHistory = true;
    private bool _isStartingIntervention;
    private bool _isAddingMaterial;
    private bool _isUploading;
    private bool _isClosing;
    private string? _closeErrorMessage;
    private string? _reportErrorMessage;
    private string? _assignmentsErrorMessage;
    private string? _interventionsErrorMessage;
    private string? _materialErrorMessage;
    private string? _attachmentsErrorMessage;
    private string? _uploadErrorMessage;
    private string? _historyErrorMessage;

    private IBrowserFile? _selectedFile;
    private int? _selectedPurposeId;
    private int? _selectedInterventionId;

    private int? _newMaterialId;
    private decimal? _newMaterialQuantity;

    private bool _hasActiveAssignment => _assignments.Any(a => a.IsActive);
    private WorkAssignmentDto? _activeAssignment => _assignments.FirstOrDefault(a => a.IsActive);
    private InterventionDto? _ongoingIntervention => _activeAssignment is null
        ? null
        : _interventions.FirstOrDefault(i => i.WorkAssignmentId == _activeAssignment.Id && i.InterventionStatusName == StatusUTijeku);

    protected override async Task OnInitializedAsync()
    {
        await LoadTechniciansAsync();
        await LoadMaterialsAsync();
        await LoadFaultReportAsync();
        await LoadAssignmentsAsync();
        await LoadInterventionsAsync();
        await LoadAttachmentPurposesAsync();
        await LoadAttachmentsAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _isLoadingHistory = true;
        _historyErrorMessage = null;

        try
        {
            _history = await Http.GetFromJsonAsync<List<FaultReportHistoryEventDto>>($"api/fault-reports/{Id}/history") ?? new();
        }
        catch (Exception ex)
        {
            _historyErrorMessage = $"Greška prilikom dohvaćanja povijesti: {ex.Message}";
        }
        finally
        {
            _isLoadingHistory = false;
        }
    }

    private static string HistoryEventIcon(string eventType) => eventType switch
    {
        "StatusChanged" => Icons.Material.Filled.Flag,
        "PriorityChanged" => Icons.Material.Filled.PriorityHigh,
        "TypeSet" => Icons.Material.Filled.Category,
        "Assigned" => Icons.Material.Filled.PersonAdd,
        "Reassigned" => Icons.Material.Filled.SwapHoriz,
        _ => Icons.Material.Filled.History
    };

    private static Color HistoryEventColor(string eventType) => eventType switch
    {
        "StatusChanged" => Color.Primary,
        "PriorityChanged" => Color.Warning,
        "TypeSet" => Color.Info,
        "Assigned" => Color.Success,
        "Reassigned" => Color.Secondary,
        _ => Color.Default
    };

    private static string HistoryEventDescription(FaultReportHistoryEventDto historyEvent) => historyEvent.EventType switch
    {
        "StatusChanged" => historyEvent.OldValue is null
            ? $"Status postavljen: {historyEvent.NewValue}"
            : $"Status promijenjen: {historyEvent.OldValue} → {historyEvent.NewValue}",
        "PriorityChanged" => historyEvent.OldValue is null
            ? $"Prioritet postavljen: {historyEvent.NewValue}"
            : $"Prioritet promijenjen: {historyEvent.OldValue} → {historyEvent.NewValue}",
        "TypeSet" => $"Tip kvara postavljen: {historyEvent.NewValue}",
        "Assigned" => $"Dodijeljen izvršitelj: {historyEvent.NewValue}",
        "Reassigned" => $"Izvršitelj promijenjen: {historyEvent.OldValue} → {historyEvent.NewValue}",
        _ => $"{historyEvent.EventType}: {historyEvent.OldValue} → {historyEvent.NewValue}"
    };

    private async Task LoadTechniciansAsync()
    {
        try
        {
            _technicians = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/technicians") ?? new();
        }
        catch (Exception ex)
        {
            _assignmentsErrorMessage = $"Greška prilikom dohvaćanja izvršitelja: {ex.Message}";
        }
    }

    private async Task LoadFaultReportAsync()
    {
        _isLoadingReport = true;
        _reportErrorMessage = null;

        try
        {
            var response = await Http.GetAsync($"api/fault-reports/{Id}");

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _faultReport = null;
            }
            else if (response.IsSuccessStatusCode)
            {
                _faultReport = await response.Content.ReadFromJsonAsync<FaultReportDto>();
            }
            else
            {
                _reportErrorMessage = $"Greška prilikom dohvaćanja prijave (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _reportErrorMessage = $"Greška prilikom dohvaćanja prijave: {ex.Message}";
        }
        finally
        {
            _isLoadingReport = false;
        }
    }

    private async Task LoadAssignmentsAsync()
    {
        _isLoadingAssignments = true;
        _assignmentsErrorMessage = null;

        try
        {
            _assignments = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>($"api/work-assignments?faultReportId={Id}") ?? new();
        }
        catch (Exception ex)
        {
            _assignmentsErrorMessage = $"Greška prilikom dohvaćanja dodjela: {ex.Message}";
        }
        finally
        {
            _isLoadingAssignments = false;
        }
    }

    private async Task OpenAssignDialogAsync()
    {
        var parameters = new DialogParameters<AssignTechnicianDialog>
        {
            { x => x.FaultReportId, Id },
            { x => x.Technicians, _technicians }
        };

        var dialog = await DialogService.ShowAsync<AssignTechnicianDialog>("Dodijeli izvršitelja", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Prijava je dodijeljena izvršitelju.", Severity.Success);
            await LoadFaultReportAsync();
            await LoadAssignmentsAsync();
            await LoadInterventionsAsync();
            await LoadHistoryAsync();
        }
    }

    private bool HasInterventions(int workAssignmentId) =>
        _interventions.Any(i => i.WorkAssignmentId == workAssignmentId);

    private async Task ShowAiSummaryAsync(int workAssignmentId)
    {
        var parameters = new DialogParameters<AiWorkOrderSummaryDialog>
        {
            { x => x.WorkAssignmentId, workAssignmentId }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };

        await DialogService.ShowAsync<AiWorkOrderSummaryDialog>("AI sažetak radnog naloga", parameters, options);
    }

    private async Task OpenReassignDialogAsync()
