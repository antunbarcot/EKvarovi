@page "/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using EKvarovi.App.Components.Dialogs
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject CurrentUserService CurrentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Korisnici</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Korisnici</MudText>

@if (_isLoading)
{
    <TableSkeleton />
}
else if (!_hasAccess)
{
    @* Prava zastita je vec [Authorize(Roles="Admin")] na UsersController-u - ovo je
       samo UX zastita da korisnik bez uloge Admin ne gleda praznu/slomljenu stranicu. *@
    <MudAlert Severity="Severity.Warning">Nemate pristup ovoj stranici.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialogAsync" Class="mb-4">
        Novi korisnik
    </MudButton>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }
    else if (_users.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.ManageAccounts" Message="Nema unesenih korisnika." />
    }
    else
    {
        <MudTable Items="_users" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Prikazno ime</MudTh>
                <MudTh>Uloge</MudTh>
                <MudTh>Povezani zaposlenik</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Akcije</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Prikazno ime">@context.DisplayName</MudTd>
                <MudTd DataLabel="Uloge">
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@role</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Povezani zaposlenik">@(context.EmployeeName ?? "-")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                        @(context.IsActive ? "Aktivan" : "Neaktivan")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Akcije">
                    <MudTooltip Text="Uredi">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditDialogAsync(context)" />
                    </MudTooltip>
                    @if (context.IsActive)
                    {
                        <MudTooltip Text="Deaktiviraj">
                            <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeactivateUserAsync(context)" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<UserAdminDto> _users = new();
    private List<LookupDto> _roles = new();
    private List<LookupDto> _employees = new();
    private bool _isLoading = true;
    private bool _hasAccess;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Bez ovoga bi provjera uloge ispod mogla ispasti pogresna - CurrentUserService
        // svoje stanje (Roles) ucitava asinkrono iz sessionStorage.
        await CurrentUserService.EnsureInitializedAsync();
        _hasAccess = CurrentUserService.IsInRole("Admin");

        if (_hasAccess)
        {
            await LoadDataAsync();
        }
        else
        {
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var usersTask = Http.GetFromJsonAsync<List<UserAdminDto>>("api/users");
            var rolesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/roles");
            var employeesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/employees");
            await Task.WhenAll(usersTask, rolesTask, employeesTask);

            _users = usersTask.Result ?? new();
            _roles = rolesTask.Result ?? new();
            _employees = employeesTask.Result ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja korisnika: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<UserEditDialog>
        {
            { x => x.Existing, null },
            { x => x.Roles, _roles },
            { x => x.Employees, _employees }
        };

        var dialog = await DialogService.ShowAsync<UserEditDialog>("Novi korisnik", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Korisnik je spremljen.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialogAsync(UserAdminDto user)
    {
        var parameters = new DialogParameters<UserEditDialog>
        {
            { x => x.Existing, user },
            { x => x.Roles, _roles },
            { x => x.Employees, _employees }
        };

        var dialog = await DialogService.ShowAsync<UserEditDialog>("Uredi korisnika", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Korisnik je spremljen.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task DeactivateUserAsync(UserAdminDto user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda deaktivacije",
            $"Jeste li sigurni da želite deaktivirati korisnika \"{user.Email}\"?",
            yesText: "Deaktiviraj", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var response = await Http.PutAsync($"api/users/{user.Id}/deactivate", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Korisnik je deaktiviran.", Severity.Success);
                await LoadDataAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var message = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Korisnika nije moguće deaktivirati." : message, Severity.Warning);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Korisnik više ne postoji.", Severity.Warning);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Greška prilikom deaktivacije korisnika.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška prilikom deaktivacije korisnika: {ex.Message}", Severity.Error);
        }
    }
}
