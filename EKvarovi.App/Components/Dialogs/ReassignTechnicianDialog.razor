@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudSelect T="int" @bind-Value="_model.TechnicianId" Label="Novi izvršitelj" Required="true"
                       RequiredError="Izvršitelj je obavezan">
                @foreach (var technician in Technicians)
                {
                    <MudSelectItem T="int" Value="technician.Id">@technician.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_model.ReassignmentNote" Label="Razlog ponovne dodjele (opcionalno)"
                          Lines="3" Class="mt-3" />
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving">
            Ponovno dodijeli
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int FaultReportId { get; set; }
    [Parameter] public List<LookupDto> Technicians { get; set; } = new();

    private MudForm _form = null!;
    private ReassignWorkAssignmentDto _model = new();
    private string? _errorMessage;
    private bool _isSaving;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/work-assignments/{FaultReportId}/reassign", _model);

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom ponovne dodjele: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var message = await response.Content.ReadFromJsonAsync<string>();
            return string.IsNullOrWhiteSpace(message)
                ? $"Greška prilikom ponovne dodjele (HTTP {(int)response.StatusCode})."
                : message;
        }
        catch
        {
            return $"Greška prilikom ponovne dodjele (HTTP {(int)response.StatusCode}).";
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
