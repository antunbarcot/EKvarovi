@inherits LayoutComponentBase
@implements IDisposable
@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject HttpClient Http

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6">e-Kvarovi Županije</MudText>
        <MudSpacer />
        @if (CurrentUserService.IsAuthenticated)
        {
            <MudAutocomplete T="SearchResultItem" Placeholder="Pretraži..." Variant="Variant.Filled" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="mx-4 mud-width-full global-search-field" Style="max-width:340px;" Dense="true" Clearable="true"
                              SearchFunc="SearchGlobalAsync" ToStringFunc="@(item => item?.Label ?? string.Empty)"
                              ValueChanged="OnSearchResultSelected" MinCharacters="2" DebounceInterval="300"
                              CoerceText="false" ResetValueOnEmptyText="true">
                <ItemTemplate Context="item">
                    <div class="d-flex align-center ga-2">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.CategoryLabel</MudText>
                            <MudText Typo="Typo.body2">@item.Label</MudText>
                        </div>
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText Class="pa-3" Typo="Typo.body2">Nema rezultata.</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
        }
        <MudTooltip Text="@(_isDarkMode ? "Uključi svijetlu temu" : "Uključi tamnu temu")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkModeAsync" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <div class="drawer-content">
            <BuildingsSilhouette Class="drawer-skyline" />
            <div class="drawer-nav">
                <NavMenu />
            </div>
        </div>
    </MudDrawer>

    <MudMainContent Class="pa-6 mt-16">
        @Body
    </MudMainContent>
</MudLayout>

<style>
    .drawer-content {
        position: relative;
        height: 100%;
    }

    .drawer-skyline {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 30%;
        min-height: 90px;
        fill: var(--mud-palette-primary);
        opacity: 0.05;
        z-index: 0;
        pointer-events: none;
    }

    .drawer-nav {
        position: relative;
        z-index: 1;
    }
</style>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] PublicPaths = { "/login" };
    private const string DarkModeStorageKey = "ekvarovi-dark-mode";

    private bool _drawerOpen = true;
    private readonly AppTheme _theme = new();
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUserService.EnsureInitializedAsync();
        RedirectIfNotAuthenticated();

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", DarkModeStorageKey);
            if (stored == "dark")
            {
                _isDarkMode = true;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DarkModeStorageKey, _isDarkMode ? "dark" : "light");
        }
        catch (JSException)
        {
        }
    }

    private sealed record SearchResultItem(string Category, string CategoryLabel, string Icon, int Id, string Label);

    private async Task<IEnumerable<SearchResultItem>> SearchGlobalAsync(string? value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            return Array.Empty<SearchResultItem>();
        }

        try
        {
            var result = await Http.GetFromJsonAsync<GlobalSearchResultDto>(
                $"api/search?query={Uri.EscapeDataString(value.Trim())}", cancellationToken);

            if (result is null)
            {
                return Array.Empty<SearchResultItem>();
            }

            var items = new List<SearchResultItem>();
            items.AddRange(result.FaultReports.Select(fr =>
                new SearchResultItem("FaultReport", "Prijava", Icons.Material.Filled.ReportProblem, fr.Id, fr.Name)));
            items.AddRange(result.Locations.Select(l =>
                new SearchResultItem("Location", "Lokacija", Icons.Material.Filled.LocationOn, l.Id, l.Name)));
            items.AddRange(result.Employees.Select(e =>
                new SearchResultItem("Employee", "Zaposlenik", Icons.Material.Filled.Person, e.Id, e.Name)));

            return items;
        }
        catch (OperationCanceledException)
        {
            return Array.Empty<SearchResultItem>();
        }
        catch (Exception)
        {
            return Array.Empty<SearchResultItem>();
        }
    }

    private void OnSearchResultSelected(SearchResultItem? item)
    {
        if (item is null)
        {
            return;
        }

        var url = item.Category switch
        {
            "FaultReport" => $"/fault-reports/{item.Id}",
            "Location" => "/locations",
            "Employee" => "/employees",
            _ => (string?)null
        };

        if (url is not null)
        {
            NavigationManager.NavigateTo(url);
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CurrentUserService.EnsureInitializedAsync();
        RedirectIfNotAuthenticated();
    }

    private void RedirectIfNotAuthenticated()
    {
        if (!CurrentUserService.IsInitialized)
        {
            return;
        }

        var path = ("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0]).ToLowerInvariant();
        if (!CurrentUserService.IsAuthenticated && !PublicPaths.Contains(path))
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
