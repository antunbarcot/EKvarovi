@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">AI sažetak radnog naloga</MudText>

        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning">@_errorMessage</MudAlert>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-3">
                @foreach (var sentence in SplitIntoSentences(_summary))
                {
                    <MudText Typo="Typo.body2" Class="mb-1">@sentence</MudText>
                }
            </MudPaper>
            <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                AI generirani sažetak - informativan je, ne mijenja podatke o nalogu.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Zatvori</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int WorkAssignmentId { get; set; }

    private bool _isLoading = true;
    private string? _summary;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/ai/work-order-summary/{WorkAssignmentId}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AiTextResponseDto>();
                _summary = result?.Summary;
            }
            else
            {
                _errorMessage = "AI sažetak trenutno nije dostupan.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "AI sažetak trenutno nije dostupan.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // MockAiService vraca jedan tekstualni blok - dijelimo ga po recenicama radi
    // citljivosti (umjesto jednog velikog paragrafa u dijalogu).
    private static List<string> SplitIntoSentences(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return new List<string> { "Nema dostupnog sažetka." };
        }

        return text
            .Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .Select(s => s + ".")
            .ToList();
    }
}
