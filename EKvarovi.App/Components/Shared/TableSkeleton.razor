@* Skeleton "sjena" tablice dok se podaci ucitavaju - zamjena za generican spinner
   na tablicnim stranicama. Broj redaka je cisto vizualan (Rows), ne odrazava stvarni
   broj stavki koje dolaze s API-ja. *@
<div class="pa-2">
    @for (var i = 0; i < Rows; i++)
    {
        <MudSkeleton SkeletonType="SkeletonType.Text" Height="40px" Class="mb-2" />
    }
</div>

@code {
    [Parameter]
    public int Rows { get; set; } = 5;
}
