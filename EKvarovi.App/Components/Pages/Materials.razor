@page "/materials"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using EKvarovi.App.Components.Dialogs
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Materijali</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Materijali</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialogAsync" Disabled="_isLoading" Class="mb-4">
    Novi materijal
</MudButton>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <TableSkeleton />
}
else if (_errorMessage is null)
{
    if (_materials.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Inventory2" Message="Nema unesenih materijala." />
    }
    else
    {
        <MudTable Items="_materials" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Naziv</MudTh>
                <MudTh>Jedinica mjere</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Akcije</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Naziv">@context.Name</MudTd>
                <MudTd DataLabel="Jedinica mjere">@context.MaterialUnitName (@context.MaterialUnitAbbreviation)</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                        @(context.IsActive ? "Aktivan" : "Neaktivan")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Akcije">
                    <MudTooltip Text="Uredi">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenEditDialogAsync(context)" />
                    </MudTooltip>
                    <MudTooltip Text="Obriši">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => DeleteMaterialAsync(context)" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<MaterialDto> _materials = new();
    private List<LookupDto> _materialUnits = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var materialsTask = Http.GetFromJsonAsync<List<MaterialDto>>("api/materials");
            var materialUnitsTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/material-units");
            await Task.WhenAll(materialsTask, materialUnitsTask);

            _materials = materialsTask.Result ?? new();
            _materialUnits = materialUnitsTask.Result ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja materijala: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<MaterialEditDialog>
        {
            { x => x.Existing, null },
            { x => x.MaterialUnits, _materialUnits }
        };

        var dialog = await DialogService.ShowAsync<MaterialEditDialog>("Novi materijal", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Materijal je spremljen.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialogAsync(MaterialDto material)
    {
        var parameters = new DialogParameters<MaterialEditDialog>
        {
            { x => x.Existing, material },
            { x => x.MaterialUnits, _materialUnits }
        };

        var dialog = await DialogService.ShowAsync<MaterialEditDialog>("Uredi materijal", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Materijal je spremljen.", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task DeleteMaterialAsync(MaterialDto material)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda brisanja",
            $"Jeste li sigurni da želite obrisati materijal \"{material.Name}\"?",
            yesText: "Obriši", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/materials/{material.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Materijal je obrisan.", Severity.Success);
                await LoadDataAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var message = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Materijal nije moguće obrisati - deaktivirajte ga umjesto brisanja." : message, Severity.Warning);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Materijal više ne postoji.", Severity.Warning);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Greška prilikom brisanja materijala.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška prilikom brisanja materijala: {ex.Message}", Severity.Error);
        }
    }
}
