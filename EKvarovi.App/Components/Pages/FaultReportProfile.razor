    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadErrorMessage = null;
    }

    private async Task UploadAttachmentAsync()
    {
        _uploadErrorMessage = null;

        if (_selectedFile is null)
        {
            _uploadErrorMessage = "Odaberite datoteku.";
            return;
        }

        if (_selectedPurposeId is null)
        {
            _uploadErrorMessage = "Odaberite namjenu privitka.";
            return;
        }

        _isUploading = true;

        try
        {
            await using var stream = _selectedFile.OpenReadStream(MaxAttachmentSizeBytes);

            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(_selectedFile.ContentType);

            content.Add(streamContent, "file", _selectedFile.Name);
            content.Add(new StringContent(Id.ToString()), "faultReportId");
            content.Add(new StringContent(_selectedPurposeId.Value.ToString()), "attachmentPurposeId");

            if (_selectedInterventionId.HasValue)
            {
                content.Add(new StringContent(_selectedInterventionId.Value.ToString()), "interventionId");
            }

            var response = await Http.PostAsync("api/attachments", content);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Privitak je uploadan.", Severity.Success);
                _selectedFile = null;
                _selectedPurposeId = null;
                _selectedInterventionId = null;
                await LoadAttachmentsAsync();
            }
            else if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.NotFound)
            {
                _uploadErrorMessage = await ReadErrorMessageAsync(response);
            }
            else
            {
                _uploadErrorMessage = $"Greška prilikom uploada (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _uploadErrorMessage = $"Greška prilikom uploada: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task DeleteAttachmentAsync(AttachmentDto attachment)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda brisanja",
            $"Jeste li sigurni da želite obrisati privitak \"{attachment.OriginalFileName}\"?",
            yesText: "Obriši", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/attachments/{attachment.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Privitak je obrisan.", Severity.Success);
                await LoadAttachmentsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Privitak više ne postoji.", Severity.Warning);
                await LoadAttachmentsAsync();
            }
            else
            {
                Snackbar.Add($"Greška prilikom brisanja (HTTP {(int)response.StatusCode}).", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška prilikom brisanja: {ex.Message}", Severity.Error);
        }
    }

