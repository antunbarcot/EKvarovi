@page "/interventions"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Intervencije</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Intervencije</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" @bind-Value="_search" Label="Pretraga opisa prijave" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_interventionStatusId" Label="Status" Clearable="true">
                @foreach (var status in _interventionStatuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_technicianId" Label="Izvršitelj" Clearable="true">
                @foreach (var technician in _technicians)
                {
                    <MudSelectItem T="int?" Value="@((int?)technician.Id)">@technician.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_dateFrom" Label="Datum od" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_dateTo" Label="Datum do" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="6" Class="d-flex align-center ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync">
                Filtriraj
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetFiltersAsync">
                Reset
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

<MudTable T="InterventionDto" ServerData="ServerReloadAsync" @ref="_table" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Prijava</MudTh>
        <MudTh>Izvršitelj</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>
            <MudTableSortLabel T="InterventionDto" SortLabel="startedAt" InitialDirection="SortDirection.Descending">
                Pokrenuto
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="InterventionDto" SortLabel="endedAt">
                Završeno
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Trajanje</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Prijava">
            <MudTooltip Text="@context.FaultReportDescription">
                <MudLink Href="@($"/fault-reports/{context.FaultReportId}")">@Truncate(context.FaultReportDescription)</MudLink>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Izvršitelj">@context.TechnicianName</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@InterventionStatusColor(context.InterventionStatusName)" Size="Size.Small">
                @context.InterventionStatusName
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Pokrenuto">@(context.StartedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudTd>
        <MudTd DataLabel="Završeno">@(context.EndedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudTd>
        <MudTd DataLabel="Trajanje">@(context.DurationMinutes.HasValue ? $"{context.DurationMinutes} min" : "-")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">Nema intervencija za zadane filtere.</MudAlert>
    </NoRecordsContent>
    <LoadingContent>
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </LoadingContent>
</MudTable>

@code {
    private MudTable<InterventionDto> _table = null!;
    private List<LookupDto> _interventionStatuses = new();
    private List<LookupDto> _technicians = new();

    private string? _errorMessage;

    private string? _search;
    private int? _interventionStatusId;
    private int? _technicianId;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var statusesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/intervention-statuses");
            var techniciansTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/technicians");
            await Task.WhenAll(statusesTask, techniciansTask);

            _interventionStatuses = statusesTask.Result ?? new();
            _technicians = techniciansTask.Result ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja šifrarnika: {ex.Message}";
        }
    }

    private async Task<TableData<InterventionDto>> ServerReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        _errorMessage = null;

        try
        {
            var query = BuildQueryString(state.SortLabel, state.SortDirection == SortDirection.Descending);
            var items = await Http.GetFromJsonAsync<List<InterventionDto>>($"api/interventions{query}", cancellationToken) ?? new();
            return new TableData<InterventionDto> { Items = items, TotalItems = items.Count };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja intervencija: {ex.Message}";
            return new TableData<InterventionDto> { Items = new List<InterventionDto>(), TotalItems = 0 };
        }
    }

    private string BuildQueryString(string? sortLabel, bool sortDescending)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            parts.Add($"search={Uri.EscapeDataString(_search)}");
        }

        if (_interventionStatusId.HasValue)
        {
            parts.Add($"interventionStatusId={_interventionStatusId.Value}");
        }

        if (_technicianId.HasValue)
        {
            parts.Add($"technicianId={_technicianId.Value}");
        }

        if (_dateFrom.HasValue)
        {
            parts.Add($"dateFrom={_dateFrom.Value:yyyy-MM-dd}");
        }

        if (_dateTo.HasValue)
        {
            parts.Add($"dateTo={_dateTo.Value:yyyy-MM-dd}");
        }

        if (!string.IsNullOrWhiteSpace(sortLabel))
        {
            parts.Add($"sortBy={Uri.EscapeDataString(sortLabel)}");
            parts.Add($"sortDescending={(sortDescending ? "true" : "false")}");
        }

        return parts.Count > 0 ? "?" + string.Join("&", parts) : string.Empty;
    }

    private async Task ApplyFiltersAsync()
    {
        await _table.ReloadServerData();
    }

    private async Task ResetFiltersAsync()
    {
        _search = null;
        _interventionStatusId = null;
        _technicianId = null;
        _dateFrom = null;
        _dateTo = null;

        await _table.ReloadServerData();
    }

    private static string Truncate(string text, int maxLength = 60)
    {
        return text.Length > maxLength ? text[..maxLength] + "…" : text;
    }

    private static Color InterventionStatusColor(string? statusName) => statusName switch
    {
        "Planirana" => Color.Default,
        "U tijeku" => Color.Info,
        "Završena" => Color.Success,
        "Neuspješna" => Color.Error,
        _ => Color.Default
    };
}
