@page "/assignments"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Aktivne dodjele</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Aktivne dodjele</MudText>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_errorMessage is null)
{
    if (_assignments.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Trenutno nema aktivnih dodjela.</MudAlert>
    }
    else
    {
        <MudTable Items="_assignments" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Prijava</MudTh>
                <MudTh>Lokacija</MudTh>
                <MudTh>Izvršitelj</MudTh>
                <MudTh>Dodijeljeno</MudTh>
                <MudTh>Akcije</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Prijava">
                    <MudTooltip Text="@context.FaultReportDescription">
                        <span>@Truncate(context.FaultReportDescription)</span>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Lokacija">@context.LocationName</MudTd>
                <MudTd DataLabel="Izvršitelj">@context.TechnicianName</MudTd>
                <MudTd DataLabel="Dodijeljeno">@context.AssignedAt.ToString("dd.MM.yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Akcije">
                    <MudTooltip Text="Otvori prijavu">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       OnClick="@(() => NavigationManager.NavigateTo($"/fault-reports/{context.FaultReportId}"))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<WorkAssignmentDto> _assignments = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignmentsAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _assignments = await Http.GetFromJsonAsync<List<WorkAssignmentDto>>("api/work-assignments?activeOnly=true") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja dodjela: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Truncate(string text, int maxLength = 60)
    {
        return text.Length > maxLength ? text[..maxLength] + "…" : text;
    }
}
