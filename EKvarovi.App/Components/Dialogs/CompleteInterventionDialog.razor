@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudRadioGroup T="bool" @bind-Value="_model.IsSuccessful">
                <MudRadio T="bool" Value="true" Color="Color.Success">Uspješno</MudRadio>
                <MudRadio T="bool" Value="false" Color="Color.Error">Neuspješno</MudRadio>
            </MudRadioGroup>
            <MudTextField T="string" @bind-Value="_model.Notes" Label="Bilješka" Required="true"
                          RequiredError="Bilješka je obavezna" Lines="3" Class="mt-3" />
            <MudNumericField T="int?" @bind-Value="_model.DurationMinutes" Label="Trajanje (min)"
                              Min="0" HelperText="Ostavi prazno za automatski izračun" Class="mt-3" />
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Size="Size.Large">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving" Size="Size.Large">
            Završi intervenciju
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int InterventionId { get; set; }

    private MudForm _form = null!;
    private CompleteInterventionDto _model = new() { IsSuccessful = true };
    private string? _errorMessage;
    private bool _isSaving;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/interventions/{InterventionId}/complete", _model);

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom završavanja intervencije: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return $"Greška prilikom završavanja (HTTP {(int)response.StatusCode}).";
        }

        if (raw.Length >= 2 && raw[0] == '"' && raw[^1] == '"')
        {
            try
            {
                return System.Text.Json.JsonSerializer.Deserialize<string>(raw) ?? raw;
            }
            catch
            {
            }
        }

        return raw;
    }

    private void Cancel() => MudDialog.Cancel();
}
