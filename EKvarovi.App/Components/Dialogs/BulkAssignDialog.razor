@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Odabranih prijava: @FaultReportIds.Count</MudText>
        <MudSelect T="int?" @bind-Value="_technicianId" Label="Izvršitelj" Required="true"
                   RequiredError="Izvršitelj je obavezan">
            @foreach (var technician in Technicians)
            {
                <MudSelectItem T="int?" Value="@((int?)technician.Id)">@FormatTechnicianLabel(technician)</MudSelectItem>
            }
        </MudSelect>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving">
            Dodijeli
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public List<int> FaultReportIds { get; set; } = new();
    [Parameter] public List<TechnicianWorkloadDto> Technicians { get; set; } = new();

    private int? _technicianId;
    private string? _errorMessage;
    private bool _isSaving;

    private async Task SubmitAsync()
    {
        if (_technicianId is null)
        {
            _errorMessage = "Izvršitelj je obavezan.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var dto = new BulkAssignDto { FaultReportIds = FaultReportIds, TechnicianId = _technicianId.Value };
            var response = await Http.PostAsJsonAsync("api/work-assignments/bulk", dto);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BulkAssignResultDto>();
                MudDialog.Close(DialogResult.Ok(result));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dodjele: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return $"Greška prilikom dodjele (HTTP {(int)response.StatusCode}).";
        }

        if (raw.Length >= 2 && raw[0] == '"' && raw[^1] == '"')
        {
            try
            {
                return System.Text.Json.JsonSerializer.Deserialize<string>(raw) ?? raw;
            }
            catch
            {
            }
        }

        return raw;
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatTechnicianLabel(TechnicianWorkloadDto technician)
    {
        var count = technician.ActiveAssignmentsCount;
        var suffix = count switch
        {
            0 => "bez aktivnih naloga",
            1 => "1 aktivan nalog",
            _ when count % 100 is >= 12 and <= 14 => $"{count} aktivnih naloga",
            _ when count % 10 is >= 2 and <= 4 => $"{count} aktivna naloga",
            _ => $"{count} aktivnih naloga"
        };

        return $"{technician.Name} ({suffix})";
    }
}
