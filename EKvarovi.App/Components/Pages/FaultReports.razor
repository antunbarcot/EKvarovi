@page "/fault-reports"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using EKvarovi.App.Components.Dialogs
@using EKvarovi.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject CurrentUserService CurrentUserService
@inject IJSRuntime JS

<PageTitle>Prijave kvarova</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Prijave kvarova</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialogAsync" Disabled="_isLoading" Class="mb-4">
    Nova prijava
</MudButton>

<MudPaper Class="pa-3 mb-4 d-flex align-center flex-wrap gap-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Brzi filteri:</MudText>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="quick-filter-btn"
               StartIcon="@Icons.Material.Filled.PriorityHigh" OnClick="ApplyQuickFilterCriticalAsync">
        Kritične
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" Class="quick-filter-btn"
               StartIcon="@Icons.Material.Filled.PersonOff" OnClick="ApplyQuickFilterUnassignedAsync">
        Bez izvršitelja
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" Class="quick-filter-btn"
               StartIcon="@Icons.Material.Filled.DateRange" OnClick="ApplyQuickFilterThisWeekAsync">
        Ovaj tjedan
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" Class="quick-filter-btn"
               StartIcon="@Icons.Material.Filled.AccessTime" OnClick="ApplyQuickFilterDueSoonAsync">
        Rok uskoro ističe
    </MudButton>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" @bind-Value="_search" Label="Pretraga opisa" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_locationId" Label="Lokacija" Clearable="true">
                @foreach (var location in _locations)
                {
                    <MudSelectItem T="int?" Value="@((int?)location.Id)">@location.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_faultStatusId" Label="Status" Clearable="true">
                @foreach (var status in _faultStatuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_faultPriorityId" Label="Prioritet" Clearable="true">
                @foreach (var priority in _faultPriorities)
                {
                    <MudSelectItem T="int?" Value="@((int?)priority.Id)">@priority.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_dateFrom" Label="Datum od" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_dateTo" Label="Datum do" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="6" Class="d-flex align-center ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync">
                Filtriraj
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetFiltersAsync">
                Reset
            </MudButton>
            @if (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager"))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_isExporting" OnClick='@(() => DownloadExportAsync("csv"))'>
                    Preuzmi CSV
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           Disabled="_isExporting" OnClick='@(() => DownloadExportAsync("pdf"))'>
                    Preuzmi PDF
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

@if (_selectedItems.Count > 0 && (CurrentUserService.IsInRole("Admin") || CurrentUserService.IsInRole("Manager")))
{
    <MudPaper Class="pa-3 mb-4 d-flex align-center justify-space-between flex-wrap ga-2" Elevation="2">
        <MudText Typo="Typo.body1">Odabrano prijava: @_selectedItems.Count</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenBulkAssignDialogAsync">
            Dodijeli odabrane (@_selectedItems.Count) izvršitelju
        </MudButton>
    </MudPaper>
}

<MudTable T="FaultReportDto" ServerData="ServerReloadAsync" @ref="_table" Hover="true" Striped="true"
          MultiSelection="true" @bind-SelectedItems="_selectedItems"
          OnRowClick="@((TableRowClickEventArgs<FaultReportDto> args) => NavigationManager.NavigateTo($"/fault-reports/{args.Item.Id}"))" RowStyle="cursor: pointer;">
    <HeaderContent>
        <MudTh>Opis</MudTh>
        <MudTh>Lokacija</MudTh>
        <MudTh>Prijavitelj</MudTh>
        <MudTh>Tip kvara</MudTh>
        <MudTh>Prioritet</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>
            <MudTableSortLabel T="FaultReportDto" SortLabel="dueDate">
                Rok
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="FaultReportDto" SortLabel="createdAt" InitialDirection="SortDirection.Descending">
                Kreirano
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Opis">
            <MudTooltip Text="@context.Description">
                <span>@Truncate(context.Description)</span>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Lokacija">@context.LocationName</MudTd>
        <MudTd DataLabel="Prijavitelj">@context.ReporterName</MudTd>
        <MudTd DataLabel="Tip kvara">@context.FaultTypeName</MudTd>
        <MudTd DataLabel="Prioritet">
            <MudChip T="string" Color="@PriorityColor(context.FaultPriorityName)" Size="Size.Small">
                @context.FaultPriorityName
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@StatusColor(context.FaultStatusName)" Size="Size.Small">
                @context.FaultStatusName
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Rok">
            <div class="d-flex align-center gap-1 due-soon-icon">
                <span>@(context.DueDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                @if (IsDueSoon(context))
                {
                    <MudTooltip Text="Rok ističe za manje od 24h">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Warning" Size="Size.Small" />
                    </MudTooltip>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="Kreirano">@context.CreatedAt.ToString("dd.MM.yyyy HH:mm")</MudTd>
        <MudTd DataLabel="Akcije">
            <span @onclick:stopPropagation="true">
                <MudTooltip Text="Detalji">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   OnClick="@(() => NavigationManager.NavigateTo($"/fault-reports/{context.Id}"))" />
                </MudTooltip>
                <MudTooltip Text="@(context.FaultStatusName == StatusZaprimljeno ? "Pregled" : "Pregled je moguć samo za status \"Zaprimljeno\"")">
                    <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small"
                                   Disabled="@(context.FaultStatusName != StatusZaprimljeno)"
                                   OnClick="() => OpenReviewDialogAsync(context)" />
                </MudTooltip>
                <MudTooltip Text="Obriši">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteFaultReportAsync(context)" />
                </MudTooltip>
            </span>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Icon="@Icons.Material.Filled.Inbox" Message="Nema prijava za zadane filtere." />
    </NoRecordsContent>
    <LoadingContent>
        <TableSkeleton />
    </LoadingContent>
</MudTable>

@code {
    private const string StatusZaprimljeno = "Zaprimljeno";
    private const string StatusRijeseno = "Riješeno";
    private const string StatusZatvoreno = "Zatvoreno";
    private const string PriorityKritican = "Kritičan";
    private const string PriorityVisok = "Visok";
    private const string PrioritySrednji = "Srednji";
    private const string PriorityNizak = "Nizak";

    private MudTable<FaultReportDto> _table = null!;
    private List<LookupDto> _locations = new();
    private List<LookupDto> _faultStatuses = new();
    private List<LookupDto> _faultPriorities = new();
    private List<LookupDto> _faultTypes = new();
    private List<LookupDto> _reporters = new();
    private List<TechnicianWorkloadDto> _technicians = new();
    private HashSet<FaultReportDto> _selectedItems = new();

    private bool _isLoading;
    private bool _isExporting;
    private string? _errorMessage;

    private string? _search;
    private int? _locationId;
    private int? _faultStatusId;
    private int? _faultPriorityId;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private bool _dueSoon;
    private bool _unassignedOnly;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var locationsTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/locations");
            var statusesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-statuses");
            var prioritiesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-priorities");
            var typesTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/fault-types");
            var reportersTask = Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/reporters");
            var techniciansTask = Http.GetFromJsonAsync<List<TechnicianWorkloadDto>>("api/lookups/technicians-with-workload");
            await Task.WhenAll(locationsTask, statusesTask, prioritiesTask, typesTask, reportersTask, techniciansTask);

            _locations = locationsTask.Result ?? new();
            _faultStatuses = statusesTask.Result ?? new();
            _faultPriorities = prioritiesTask.Result ?? new();
            _faultTypes = typesTask.Result ?? new();
            _reporters = reportersTask.Result ?? new();
            _technicians = techniciansTask.Result ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja šifrarnika: {ex.Message}";
        }
    }

    private async Task<TableData<FaultReportDto>> ServerReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var query = BuildQueryString(state.SortLabel, state.SortDirection == SortDirection.Descending);
            var items = await Http.GetFromJsonAsync<List<FaultReportDto>>($"api/fault-reports{query}", cancellationToken) ?? new();
            return new TableData<FaultReportDto> { Items = items, TotalItems = items.Count };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dohvaćanja prijava: {ex.Message}";
            return new TableData<FaultReportDto> { Items = new List<FaultReportDto>(), TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string BuildQueryString(string? sortLabel, bool sortDescending)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            parts.Add($"search={Uri.EscapeDataString(_search)}");
        }

        if (_locationId.HasValue)
        {
            parts.Add($"locationId={_locationId.Value}");
        }

        if (_faultStatusId.HasValue)
        {
            parts.Add($"faultStatusId={_faultStatusId.Value}");
        }

        if (_faultPriorityId.HasValue)
        {
            parts.Add($"faultPriorityId={_faultPriorityId.Value}");
        }

        if (_dateFrom.HasValue)
        {
            parts.Add($"dateFrom={_dateFrom.Value:yyyy-MM-dd}");
        }

        if (_dateTo.HasValue)
        {
            parts.Add($"dateTo={_dateTo.Value:yyyy-MM-dd}");
        }

        if (_dueSoon)
        {
            parts.Add("dueSoon=true");
        }

        if (_unassignedOnly)
        {
            parts.Add("unassignedOnly=true");
        }

        if (!string.IsNullOrWhiteSpace(sortLabel))
        {
            parts.Add($"sortBy={Uri.EscapeDataString(sortLabel)}");
            parts.Add($"sortDescending={(sortDescending ? "true" : "false")}");
        }

        return parts.Count > 0 ? "?" + string.Join("&", parts) : string.Empty;
    }

    private async Task ApplyFiltersAsync()
    {
        await _table.ReloadServerData();
    }

    private async Task ResetFiltersAsync()
    {
        _search = null;
        ClearFiltersExceptSearch();

        await _table.ReloadServerData();
    }

    // Zajednicko za sve brze filtere ispod - svaki klik daje CIST rezultat (samo taj
    // jedan kriterij), ne kombinaciju sa sto god je vec bilo postavljeno. Tekst pretrage
    // namjerno NIJE ovdje (ostaje netaknut) - "Kritične" nad vec upisanom pretragom i dalje
    // ima smisla kao "kritične koje sadrze X u opisu", za razliku od ostalih filtera koji bi
    // se medusobno iskljucivali.
    private void ClearFiltersExceptSearch()
    {
        _locationId = null;
        _faultStatusId = null;
        _faultPriorityId = null;
        _dateFrom = null;
        _dateTo = null;
        _dueSoon = false;
        _unassignedOnly = false;
    }

    private async Task ApplyQuickFilterCriticalAsync()
    {
        ClearFiltersExceptSearch();
        _faultPriorityId = _faultPriorities.FirstOrDefault(p => p.Name == PriorityKritican)?.Id;
        await _table.ReloadServerData();
    }

    private async Task ApplyQuickFilterUnassignedAsync()
    {
        ClearFiltersExceptSearch();
        _unassignedOnly = true;
        await _table.ReloadServerData();
    }

    private async Task ApplyQuickFilterThisWeekAsync()
    {
        ClearFiltersExceptSearch();
        var today = DateTime.Today;
        var daysSinceMonday = ((int)today.DayOfWeek + 6) % 7;
        _dateFrom = today.AddDays(-daysSinceMonday);
        _dateTo = today;
        await _table.ReloadServerData();
    }

    private async Task ApplyQuickFilterDueSoonAsync()
    {
        ClearFiltersExceptSearch();
        _dueSoon = true;
        await _table.ReloadServerData();
    }

    // HttpClient u Blazor Serveru poziva ide SA servera, ne iz preglednika - obicna
    // navigacija/anchor na API URL ne bi ponijela JWT (auth handler ga dodaje samo
    // ovom HttpClient-u), a puko "GetAsync" u C#-u sam po sebi ne pokrece download
    // u pregledniku korisnika. Zato: server dohvati bajtove kroz vec auth-ozicani
    // Http, pretvori u base64 i preda ih JS-u (wwwroot/js/fileDownload.js) koji
    // tek gradi Blob + privremeni <a download> - to je dio koji preglednik stvarno
    // pokrene kao "spremi datoteku".
    private async Task DownloadExportAsync(string format)
    {
        _isExporting = true;

        try
        {
            var query = BuildQueryString(sortLabel: null, sortDescending: false);
            var response = await Http.GetAsync($"api/fault-reports/export/{format}{query}");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Greška prilikom izvoza.", Severity.Error);
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var contentType = format == "csv" ? "text/csv" : "application/pdf";
            var fileName = $"fault-reports-export.{format}";

            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška prilikom izvoza: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<NewFaultReportDialog>
        {
            { x => x.Locations, _locations },
            { x => x.Reporters, _reporters }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<NewFaultReportDialog>("Nova prijava kvara", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Prijava je spremljena.", Severity.Success);
            await _table.ReloadServerData();
        }
    }

    private async Task OpenReviewDialogAsync(FaultReportDto faultReport)
    {
        var parameters = new DialogParameters<ReviewFaultReportDialog>
        {
            { x => x.Existing, faultReport },
            { x => x.FaultTypes, _faultTypes },
            { x => x.FaultPriorities, _faultPriorities }
        };

        var dialog = await DialogService.ShowAsync<ReviewFaultReportDialog>("Pregled prijave", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Prijava je pregledana.", Severity.Success);
            await _table.ReloadServerData();
        }
    }

    private async Task OpenBulkAssignDialogAsync()
    {
        var parameters = new DialogParameters<BulkAssignDialog>
        {
            { x => x.FaultReportIds, _selectedItems.Select(fr => fr.Id).ToList() },
            { x => x.Technicians, _technicians }
        };

        var dialog = await DialogService.ShowAsync<BulkAssignDialog>("Dodjela izvršitelju", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is BulkAssignResultDto bulkResult)
        {
            var message = bulkResult.Skipped.Count == 0
                ? $"Dodijeljeno prijava: {bulkResult.SuccessCount}."
                : $"Dodijeljeno prijava: {bulkResult.SuccessCount}. Preskočeno: {bulkResult.Skipped.Count} (već ima aktivnu dodjelu ili ne postoji).";

            Snackbar.Add(message, bulkResult.Skipped.Count == 0 ? Severity.Success : Severity.Warning);
            _selectedItems.Clear();
            await _table.ReloadServerData();
        }
    }

    private async Task DeleteFaultReportAsync(FaultReportDto faultReport)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Potvrda brisanja",
            $"Jeste li sigurni da želite obrisati prijavu \"{Truncate(faultReport.Description)}\"?",
            yesText: "Obriši", cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/fault-reports/{faultReport.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Prijava je obrisana.", Severity.Success);
                await _table.ReloadServerData();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var message = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Prijavu nije moguće obrisati." : message, Severity.Warning);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Prijava više ne postoji.", Severity.Warning);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add("Greška prilikom brisanja prijave.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška prilikom brisanja prijave: {ex.Message}", Severity.Error);
        }
    }

    // Isto pravilo kao DashboardController.UpcomingDueFaultReportsCount i
    // FaultReportsController BuildFilteredQuery (dueSoon=true) - ovdje samo vizualni
    // indikator na vec ucitanom retku, ne zaseban API poziv.
    private static bool IsDueSoon(FaultReportDto faultReport)
    {
        if (faultReport.DueDate is null || faultReport.FaultStatusName is StatusRijeseno or StatusZatvoreno)
        {
            return false;
        }

        var now = DateTime.UtcNow;
        return faultReport.DueDate.Value >= now && faultReport.DueDate.Value <= now.AddHours(24);
    }

    private static string Truncate(string text, int maxLength = 60)
    {
        return text.Length > maxLength ? text[..maxLength] + "…" : text;
    }

    private static Color PriorityColor(string priorityName) => priorityName switch
    {
        PriorityKritican => Color.Error,
        PriorityVisok => Color.Warning,
        PrioritySrednji => Color.Info,
        PriorityNizak => Color.Success,
        _ => Color.Default
    };

    private static Color StatusColor(string statusName) => statusName switch
    {
        "Zaprimljeno" => Color.Default,
        "Pregledano" => Color.Info,
        "Dodijeljeno" => Color.Info,
        "U radu" => Color.Warning,
        "Riješeno" => Color.Success,
        "Zatvoreno" => Color.Secondary,
        _ => Color.Default
    };
}
