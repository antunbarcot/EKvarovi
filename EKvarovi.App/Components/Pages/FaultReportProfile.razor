    private string InterventionComparisonLabel(int? interventionId)
    {
        if (!interventionId.HasValue)
        {
            return "Intervencija";
        }

        var intervention = _interventions.FirstOrDefault(i => i.Id == interventionId.Value);
        return intervention is not null
            ? $"Intervencija #{intervention.Id} - {intervention.TechnicianName} ({intervention.InterventionStatusName})"
            : $"Intervencija #{interventionId}";
    }

    private static string PurposeDisplayName(string? purposeName) => purposeName switch
    {
        PurposeFotografijaPrije => "Fotografija prije",
        PurposeFotografijaPoslije => "Fotografija poslije",
        PurposeDokument => "Dokument",
        _ => purposeName ?? string.Empty
    };

    private static string FormatFileSize(long bytes)
    {
        const long kb = 1024;
        const long mb = kb * 1024;

        if (bytes >= mb)
        {
            return $"{bytes / (double)mb:0.#} MB";
        }

        if (bytes >= kb)
        {
            return $"{bytes / (double)kb:0.#} KB";
        }

        return $"{bytes} B";
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            // BadRequest(string) na API strani vraca "text/plain" tijelo (ne JSON),
            // pa ReadFromJsonAsync<string> baca iznimku i uvijek pada na generičku poruku.
            var message = await response.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(message)
                ? $"Greška (HTTP {(int)response.StatusCode})."
                : message;
        }
        catch
        {
            return $"Greška (HTTP {(int)response.StatusCode}).";
        }
    }

