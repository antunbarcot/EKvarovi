@page "/about"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>O aplikaciji</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">O aplikaciji</MudText>

<MudPaper Class="pa-6" Elevation="2">
    <MudText Typo="Typo.body1" Class="mb-4">
        e-Kvarovi Županije je web aplikacija namijenjena upravljanju prijavama i obradom kvarova u
        županijskim zgradama i lokacijama (upravne zgrade, škole, zdravstvene ustanove...).
        Omogućuje prijaviteljima, upraviteljima i izvršiteljima pregled i upravljanje prijavama,
        dodjelama izvršitelja, intervencijama i utrošenim materijalom.
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-4">
        Aplikacija je razvijena kao završni projekt JuniorDev tečaja Digitalne Dalmacije
        korištenjem tehnologija Blazor, ASP.NET Core Web API i Entity Framework Core, uz SQLite
        bazu podataka.
    </MudText>

    <MudText Typo="Typo.body2" Class="mud-text-secondary">Izradio: Junior Developer Antun Barčot</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Verzija: 1.0.0</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Godina: 2026.</MudText>
</MudPaper>
