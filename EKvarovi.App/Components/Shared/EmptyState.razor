@* Zajednicki "prazno stanje" prikaz za tablice/liste - cisto vizualna zamjena za
   obican MudAlert Info tekst. Ne nosi nikakvu logiku o TOME KADA se prikazuje -
   svaka stranica i dalje sama odlucuje o uvjetu, ova komponenta samo iscrtava. *@
<div class="pa-8 d-flex flex-column align-center">
    <MudIcon Icon="@Icon" Size="Size.Large" Class="mud-text-secondary mb-2" Style="opacity:0.5;" />
    <MudText Typo="Typo.body1" Class="mud-text-secondary" Align="Align.Center">@Message</MudText>
</div>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;
}
