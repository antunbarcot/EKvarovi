@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudSelect T="int" @bind-Value="_model.TechnicianId" Label="Izvršitelj" Required="true"
                       RequiredError="Izvršitelj je obavezan">
                @foreach (var technician in Technicians)
                {
                    <MudSelectItem T="int" Value="technician.Id">@FormatTechnicianLabel(technician)</MudSelectItem>
                }
            </MudSelect>
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving">
            Dodijeli
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int FaultReportId { get; set; }
    [Parameter] public List<TechnicianWorkloadDto> Technicians { get; set; } = new();

    private MudForm _form = null!;
    private CreateWorkAssignmentDto _model = new();
    private string? _errorMessage;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        _model.FaultReportId = FaultReportId;
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/work-assignments", _model);

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom dodjele: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return $"Greška prilikom dodjele (HTTP {(int)response.StatusCode}).";
        }

        if (raw.Length >= 2 && raw[0] == '"' && raw[^1] == '"')
        {
            try
            {
                return System.Text.Json.JsonSerializer.Deserialize<string>(raw) ?? raw;
            }
            catch
            {
            }
        }

        return raw;
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatTechnicianLabel(TechnicianWorkloadDto technician)
    {
        var count = technician.ActiveAssignmentsCount;
        var suffix = count switch
        {
            0 => "bez aktivnih naloga",
            1 => "1 aktivan nalog",
            _ when count % 100 is >= 12 and <= 14 => $"{count} aktivnih naloga",
            _ when count % 10 is >= 2 and <= 4 => $"{count} aktivna naloga",
            _ => $"{count} aktivnih naloga"
        };

        return $"{technician.Name} ({suffix})";
    }
}
