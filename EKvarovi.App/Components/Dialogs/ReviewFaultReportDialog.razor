@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Existing.Description</MudText>

        <MudForm @ref="_form" Model="_model">
            <MudSelect T="int" @bind-Value="_model.FaultTypeId" Label="Tip kvara" Required="true"
                       RequiredError="Tip kvara je obavezan">
                @foreach (var faultType in FaultTypes)
                {
                    <MudSelectItem T="int" Value="faultType.Id">@faultType.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="_model.FaultPriorityId" Label="Prioritet" Required="true"
                       RequiredError="Prioritet je obavezan" Class="mt-3">
                @foreach (var priority in FaultPriorities)
                {
                    <MudSelectItem T="int" Value="priority.Id">@priority.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="_model.DueDate" Label="Rok"
                           HelperText="@(_isCriticalSelected ? "Obavezno za prioritet \"Kritičan\"" : null)"
                           Class="mt-3" />
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving">
            Spremi pregled
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public FaultReportDto Existing { get; set; } = null!;
    [Parameter] public List<LookupDto> FaultTypes { get; set; } = new();
    [Parameter] public List<LookupDto> FaultPriorities { get; set; } = new();

    private const string PriorityKritican = "Kritičan";

    private MudForm _form = null!;
    private ReviewFaultReportDto _model = new();
    private string? _errorMessage;
    private bool _isSaving;

    private bool _isCriticalSelected =>
        FaultPriorities.FirstOrDefault(p => p.Id == _model.FaultPriorityId)?.Name == PriorityKritican;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/fault-reports/{Existing.Id}/review", _model);

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom spremanja pregleda: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        // API-jev BadRequest(string) stize kao goli "text/plain" (ne "application/json"),
        // pa ReadFromJsonAsync<string>() ovdje puca ("'X' is an invalid start of a value").
        // ReadAsStringAsync radi za oba slucaja - i za goli tekst i za JSON-citiran string.
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return $"Greška prilikom spremanja (HTTP {(int)response.StatusCode}).";
        }

        if (raw.Length >= 2 && raw[0] == '"' && raw[^1] == '"')
        {
            try
            {
                return System.Text.Json.JsonSerializer.Deserialize<string>(raw) ?? raw;
            }
            catch
            {
                // padne na goli tekst ispod
            }
        }

        return raw;
    }

    private void Cancel() => MudDialog.Cancel();
}
