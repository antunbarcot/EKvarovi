@using System.Net.Http.Json
@using EKvarovi.Shared.DTOs
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField T="string" @bind-Value="_model.Name" Label="Naziv" Required="true"
                          RequiredError="Naziv je obavezan" MaxLength="200" />
            <MudSelect T="int" @bind-Value="_model.MaterialUnitId" Label="Jedinica mjere" Required="true"
                       RequiredError="Jedinica mjere je obavezna" Class="mt-3">
                @foreach (var unit in MaterialUnits)
                {
                    <MudSelectItem T="int" Value="unit.Id">@unit.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_model.IsActive" Label="Aktivan" Color="Color.Primary" Class="mt-3" />
        </MudForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_isSaving">
            Spremi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public MaterialDto? Existing { get; set; }
    [Parameter] public List<LookupDto> MaterialUnits { get; set; } = new();

    private MudForm _form = null!;
    private SaveMaterialDto _model = new() { IsActive = true };
    private string? _errorMessage;
    private bool _isSaving;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _model = new SaveMaterialDto
            {
                Name = Existing.Name,
                MaterialUnitId = Existing.MaterialUnitId,
                IsActive = Existing.IsActive
            };
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var response = Existing is null
                ? await Http.PostAsJsonAsync("api/materials", _model)
                : await Http.PutAsJsonAsync($"api/materials/{Existing.Id}", _model);

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = await ReadErrorMessageAsync(response);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Greška prilikom spremanja materijala: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var message = await response.Content.ReadFromJsonAsync<string>();
            return string.IsNullOrWhiteSpace(message)
                ? $"Greška prilikom spremanja (HTTP {(int)response.StatusCode})."
                : message;
        }
        catch
        {
            return $"Greška prilikom spremanja (HTTP {(int)response.StatusCode}).";
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
